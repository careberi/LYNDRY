# LYNDRY environment variables
#
# HOW TO USE THIS FILE
#   1. Make a copy of it in this same folder and name the copy  .env
#   2. Fill in the values using the notes below
#   3. Never commit .env — it is already in .gitignore and must stay there
#
# Leave a value blank if you haven't got to that phase yet. The server will
# still start and will tell you on boot which ones are missing.


# --- Anthropic (the AI that reads customer texts) -- phase 4 ----------------
# Get the key at console.anthropic.com -> Settings -> API Keys.
# Starts with "sk-ant-". Treat it like a password.
ANTHROPIC_API_KEY=

# Which Claude model to use. Read once when the server boots, never guessed
# at per message. Leave this as claude-sonnet-5 unless we agree to change it.
ANTHROPIC_MODEL=claude-sonnet-5


# --- Supabase (the database) -- phase 2 -------------------------------------
# In your Supabase project: Settings -> Data API -> Project URL.
# Looks like https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Settings -> API Keys -> service_role (click to reveal).
# This key bypasses all database security rules. It belongs ONLY on the
# server and must never appear in a web page or be shared.
SUPABASE_SERVICE_ROLE_KEY=


# --- Telnyx (sends and receives text messages) -- phase 3 -------------------
# portal.telnyx.com -> API Keys -> create a key. Starts with "KEY".
TELNYX_API_KEY=

# portal.telnyx.com -> API Keys -> Public Key.
# Used to prove an incoming webhook genuinely came from Telnyx and not from
# someone who found our URL. Without this we cannot trust inbound messages.
TELNYX_PUBLIC_KEY=

# portal.telnyx.com -> Messaging -> Messaging Profiles -> the profile's ID.
TELNYX_MESSAGING_PROFILE_ID=

# The phone number customers text, in +1XXXXXXXXXX format.
LYNDRY_PHONE_NUMBER=

# Leave TELNYX_API_KEY and TELNYX_PUBLIC_KEY blank while developing. The app
# falls back to a fake SMS driver that prints messages to the terminal instead
# of sending them, which is what lets you test everything with
# `npm run sms` before carrier registration is approved. The fake driver
# refuses to run in production.


# --- Where a handed-off conversation reaches you ----------------------------
# Neil's personal mobile, +1XXXXXXXXXX. Used only when the AI gives up and a
# human needs to take over. This is NEVER shown on the website.
SUPPORT_PHONE=


# --- Numbers that can always book -------------------------------------------
# Comma separated. These numbers can put an order through even while the
# service is closed and from an address outside Bergen County, so the whole
# thing can be tested end to end and a favour can be taken for somebody you
# know. Everything else still applies to them: an address, wash preferences,
# a card and a real date.
#
# Leave it blank and SUPPORT_PHONE is used, which is usually what you want.
ALWAYS_BOOK_NUMBERS=


# --- Shelly (the smart relay that opens a locker) -- phase 7 ----------------
# Shelly Cloud -> Settings -> Authorization Cloud Key. The dialog shows both
# the server URI and the key. Not needed until we have physical lockers.
SHELLY_SERVER_URI=
SHELLY_AUTH_KEY=


# Optional. Where sign-in codes are sent FROM — a short code, or a second
# number, if you ever want codes separated from the conversation.
#
# Leave it blank and codes go from LYNDRY_PHONE_NUMBER like everything else,
# which is the sensible default: one number, one thread the customer can reply
# to. Only sign-in codes use this. Order confirmations and the AI's replies
# always come from the main number, because customers reply to those.
LYNDRY_CODE_NUMBER=


# --- Meta advertising pixel (the /bergen landing page only) -----------------
# OPTIONAL. LYNDRY's own pixel id is already in src/config.js, so the advert
# page works without setting anything here. A pixel id is not a secret - it is
# in the page source of every site that uses one.
#
# Set this only to point /bergen at a DIFFERENT pixel, such as a test one.
#
# The pixel only ever loads in production, so nothing you do locally reaches
# the real campaign's numbers. Only /bergen loads it; no other page does.
META_PIXEL_ID=

# --- Stripe (holds the cards) -- phase 8 ------------------------------------
# Stripe Dashboard -> Developers -> API keys -> Secret key.
#
# THE PREFIX IS THE SWITCH. sk_test_ is a sandbox where nothing real happens;
# sk_live_ moves actual money. There is no separate setting. Check /health to
# see which one the running server picked up.
STRIPE_SECRET_KEY=

# Stripe Dashboard -> Developers -> Webhooks -> add an endpoint pointing at
#   https://lyndry.com/webhooks/stripe
# subscribed to: checkout.session.completed, payment_intent.succeeded,
#                payment_intent.payment_failed
# Then copy the "Signing secret" it shows you (starts whsec_).
#
# Without this, every webhook is rejected — which means a saved card is never
# recorded and the customer is stuck.
STRIPE_WEBHOOK_SECRET=


# --- LYNDRY's own settings --------------------------------------------------
# A long random password you invent yourself. Drivers' phones send it in a
# header to use the /ops endpoints. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# The public address of this app, no trailing slash.
# Locally:    http://localhost:3000
# In production: https://lyndry.com
APP_BASE_URL=http://localhost:3000

# "development" on your laptop, "production" on Railway.
NODE_ENV=development
